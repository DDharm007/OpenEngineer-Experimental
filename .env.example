# ===================================================================
# Open Engineer / Craftorā Environment Configuration
# Copy this file to .env.local and fill in your API keys:
# cp .env.example .env.local
# ===================================================================

# -------------------------------------------------------------------
# 1. CORE SANDBOX (REQUIRED for live preview & code execution)
# -------------------------------------------------------------------
# Get your E2B API key from https://e2b.dev
E2B_API_KEY=your_e2b_api_key_here

# -------------------------------------------------------------------
# 2. WEB SCRAPING & CLONING (OPTIONAL - for website clone feature)
# -------------------------------------------------------------------
# Get your Firecrawl API key from https://firecrawl.dev
FIRECRAWL_API_KEY=your_firecrawl_api_key_here

# -------------------------------------------------------------------
# 3. AI PROVIDERS (Configure at least ONE provider to generate code)
# -------------------------------------------------------------------

# NVIDIA NIM API (Recommended - provides access to GLM-5.2, DeepSeek, Nemotron, MiniMax)
# Get yours at https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_nim_api_key_here

# Groq (High-speed inference)
# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Groq Refine Prompt (Dedicated key for AI prompt enhancer)
GROQ_REFINE_API_KEY=your_groq_refine_api_key_here

# Google Gemini (Powers Gemini models and Multi-Agent Orchestrator)
# Get yours at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (GPT-4o, GPT-5, o-series)
# Get yours at https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (Claude 3.5 Sonnet, Claude 3.7 Sonnet)
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional Alternative Providers
KIMI_API_KEY=your_kimi_api_key_here
DASHSCOPE_API_KEY=your_dashscope_api_key_here
GLM_API_KEY=your_glm_api_key_here
ZHIPU_API_KEY=your_zhipu_api_key_here

# -------------------------------------------------------------------
# 4. ENVIRONMENT SETTINGS
# -------------------------------------------------------------------
NODE_ENV=development
